%%{init: {'theme': 'neutral'}}%%
flowchart TD
    A["Super Admin creates project"] --> B["Postgres schema<br/>provisioned<br/>(isolated per project)"]
    B --> C["Creator auto-added<br/>as first member"]
    C --> D{"Shareable link<br/>distributed"}
    D --> E["Other users click link<br/>and self-join"]
    D --> F["Super Admin assigns<br/>an Admin to this project"]
    E --> G["Members create issues"]
    F --> G
    G --> H["Issues move through<br/>To Do → In Progress → Done"]
    H --> I{"Project still needed?"}
    I -->|Yes| G
    I -->|No| J["Super Admin or assigned<br/>Admin deletes project"]
    J --> K["Schema + all issues<br/>permanently removed"]

    style A fill:#fde68a,stroke:#92400e
    style J fill:#fecaca,stroke:#7f1d1d
    style K fill:#fecaca,stroke:#7f1d1d

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id                  String     @id @default(cuid())
  username            String     @unique
  name                String?
  email               String?    @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  mustChangePassword  Boolean    @default(true)
  role                GlobalRole @default(USER)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  accounts            Account[]
  sessions            Session[]
  createdProjects     Project[]       @relation("ProjectCreator")
  memberships         ProjectMember[]
  adminAssignments    ProjectAdmin[]  @relation("ProjectAdminUser")
  assignmentsMade     ProjectAdmin[]  @relation("ProjectAdminAssignedBy")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  schemaName  String          @unique
  createdById String
  // Restrict (default): a user who created a project can't be deleted
  // until that project is deleted/reassigned first. Explicit here so
  // it's a deliberate choice, not an accidental default.
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  admins      ProjectAdmin[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectAdmin {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  // Nullable + SetNull: the assigner is an audit trail, not a hard
  // dependency — deleting them should not block deleting this
  // assignment's own target user, nor force deleting the assignment.
  assignedById String?
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("ProjectAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("ProjectAdminAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
}

model RateLimitEntry {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}
